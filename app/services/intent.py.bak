import json
import logging
import os

import anthropic
from dotenv import load_dotenv

from app.services.history import trim_history

load_dotenv()

logger = logging.getLogger(__name__)

MODEL = os.getenv(
    "ANTHROPIC_INTENT_MODEL",
    os.getenv("ANTHROPIC_MODEL", "claude-haiku-4-5-20251001"),
)

client = anthropic.Anthropic(
    api_key=os.getenv("ANTHROPIC_API_KEY")
)

VALID_INTENTS = {
    "general_inquiry",
    "service_inquiry",
    "service_request",
    "booking_inquiry",
    "booking_request",
    "reschedule_request",
    "human_request",
    "complaint",
    "unclear",
}

VALID_ACTIONS = {"reply", "handoff"}

# These actions are required by the current business workflow.
MANDATORY_HANDOFF = {
    "service_request",
    "reschedule_request",
    "human_request",
}


def fallback_decision(reason: str) -> dict:
    return {
        "intent": "unclear",
        "action": "reply",
        "reason": reason,
    }


def classify_intent(
    message: str,
    conversation_context: str = "",
) -> dict:
    """
    Understand the customer's intent and select an action.

    Returns:
        {
            "intent": str,
            "action": "reply" | "handoff",
            "reason": str
        }
    """

    message = (message or "").strip()
    conversation_context = trim_history(
        conversation_context,
        8000,
    )

    if not message:
        return fallback_decision("Empty message.")

    prompt = f"""
You are the intent understanding and action decision engine
for Hakeem Care, a healthcare customer-support assistant.

Your task is to understand what the customer MEANS,
not to match keywords.

Understand:
- Arabic and Saudi Arabic dialects.
- English and mixed-language messages.
- Different ways of expressing the same intention.
- The latest message in the context of the conversation.

Return one JSON object with exactly these fields:

{{
  "intent": "...",
  "action": "reply or handoff",
  "reason": "Short explanation"
}}

VALID INTENTS:

- general_inquiry
- service_inquiry
- service_request
- booking_inquiry
- booking_request
- reschedule_request
- human_request
- complaint
- unclear

ACTION RULES:

1. service_inquiry:
The customer asks about a service, its availability,
price, requirements, scope, or how it works.
Action: reply.

2. service_request:
The customer actually wants the service to be performed.
For example, they provide lab results and ask the team
to read or interpret them, or clearly ask to start
the lab interpretation service.
Action: handoff.

Important distinction:
Asking whether lab interpretation is available is an inquiry.
Actually asking the team to interpret the customer's results
is a service request.

3. booking_inquiry:
The customer asks about booking procedures or availability.
Action: reply.

4. booking_request:
The customer wants to make a booking.
Choose the action according to whether the request
can be handled by the assistant or requires staff.

5. reschedule_request:
The customer wants to change an existing appointment.
Action: handoff.

6. human_request:
The customer explicitly asks to speak to a human,
employee, or customer-support agent.
Action: handoff.

7. complaint:
The customer expresses dissatisfaction or reports a problem.
Do not automatically transfer every complaint.
Choose handoff only when human intervention is required.

8. general_inquiry:
Normal questions, greetings, acknowledgements,
and requests for information.
Action: reply.

9. unclear:
The intention cannot be confidently determined.
Prefer reply and ask for clarification when appropriate.

IMPORTANT SAFEGUARDS:

- Do not classify based on isolated words.
- Mentioning a service does not mean requesting it.
- Asking "Can you provide this service?" is an inquiry.
- Asking "Please perform this service for me" is a request.
- A medical question does not automatically require handoff.
- A previous handoff does not automatically apply to the
  latest message.
- A topic change must be classified independently.
- Do not invent a human-support workflow.
- Use the conversation history only when it helps understand
  the current message.
- Never treat a simple question as consent to transfer.

RECENT CONVERSATION:
<conversation>
{conversation_context or "(No conversation history supplied)"}
</conversation>

LATEST CUSTOMER MESSAGE:
<latest_message>
{message}
</latest_message>

Return valid JSON only. No Markdown or additional text.
""".strip()

    try:
        response = client.messages.create(
            model=MODEL,
            max_tokens=180,
            messages=[
                {
                    "role": "user",
                    "content": prompt,
                }
            ],
        )

        response_text = "".join(
            block.text
            for block in response.content
            if getattr(block, "type", None) == "text"
        ).strip()

        # Allow JSON wrapped in Markdown fences.
        start = response_text.find("{")
        end = response_text.rfind("}")

        if start == -1 or end <= start:
            raise ValueError(
                f"Invalid JSON response: {response_text!r}"
            )

        decision = json.loads(response_text[start:end + 1])

        intent = decision.get("intent")
        action = decision.get("action")
        reason = decision.get("reason", "")

        if intent not in VALID_INTENTS:
            raise ValueError(f"Invalid intent: {intent!r}")

        if action not in VALID_ACTIONS:
            raise ValueError(f"Invalid action: {action!r}")

        if not isinstance(reason, str):
            raise ValueError("Invalid decision reason.")

        # Enforce mandatory business workflows.
        if intent in MANDATORY_HANDOFF:
            action = "handoff"

        # Information-only intents must never trigger a transfer.
        if intent in {
            "general_inquiry",
            "service_inquiry",
            "booking_inquiry",
            "unclear",
        }:
            action = "reply"

        result = {
            "intent": intent,
            "action": action,
            "reason": reason[:300],
        }

        logger.info(
            "Intent decision: intent=%s action=%s reason=%s",
            result["intent"],
            result["action"],
            result["reason"],
        )

        return result

    except Exception:
        logger.exception("Intent classification failed.")
        return fallback_decision(
            "Intent classification failed; using safe fallback."
        )
